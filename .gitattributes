# Переводы строк: скрипты и конфиги для Linux — всегда LF (иначе bash/nginx/systemd ломаются),
# bat-файлы Windows — CRLF, Python — LF.
* text=auto
*.py        text eol=lf
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
*.env       text eol=lf
*.yml       text eol=lf
server/bctl           text eol=lf
server/Dockerfile     text eol=lf
server/deploy/Caddyfile text eol=lf
*.bat       text eol=crlf
