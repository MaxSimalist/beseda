#!/usr/bin/env bash
# Управление «Беседой» в Docker. Запускать в папке server (через sudo, если вы не в группе docker).
#   ./bctl status | logs | restart | stop | start | update
#   ./bctl backup                     — архив базы и файлов в ./backups
#   ./bctl users | make-admin ЛОГИН | reset-password ЛОГИН [ПАРОЛЬ] | unban ЛОГИН
set -euo pipefail
cd "$(dirname "$0")"
# docker compose v2 (плагин) или docker-compose v1 (отдельная утилита)
if docker compose version >/dev/null 2>&1; then DC="docker compose"; else DC="docker-compose"; fi
cmd="${1:-help}"; shift || true
case "$cmd" in
  status)   $DC ps ;;
  logs)     $DC logs -f --tail 100 "${@:-beseda}" ;;
  restart)  $DC restart ;;
  stop)     $DC stop ;;
  start)    $DC up -d ;;
  update)   $DC up -d --build --remove-orphans && docker image prune -f >/dev/null ;;
  backup)
    f="$($DC exec -T beseda python -m beseda_server.manage backup | tr -d '\r')"
    mkdir -p backups
    $DC cp "beseda:$f" "backups/$(basename "$f")"
    chmod 600 "backups/$(basename "$f")"  # внутри хэши паролей
    $DC exec -T beseda rm -f "$f"
    echo "Готово: backups/$(basename "$f")" ;;
  users|make-admin|reset-password|unban)
    $DC exec -T beseda python -m beseda_server.manage "$cmd" "$@" ;;
  *) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
