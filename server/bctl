#!/usr/bin/env bash
# Управление «Беседой» в Docker. Запускать в папке server (через sudo, если вы не в группе docker).
#   ./bctl status | logs | restart | stop | start | update
#   ./bctl backup                     — архив базы и файлов в ./backups
#   ./bctl users | make-admin ЛОГИН | reset-password ЛОГИН [ПАРОЛЬ] | unban ЛОГИН
set -euo pipefail
cd "$(dirname "$0")"
cmd="${1:-help}"; shift || true
case "$cmd" in
  status)   docker compose ps ;;
  logs)     docker compose logs -f --tail 100 "${@:-beseda}" ;;
  restart)  docker compose restart ;;
  stop)     docker compose stop ;;
  start)    docker compose up -d ;;
  update)   docker compose up -d --build --remove-orphans && docker image prune -f >/dev/null ;;
  backup)
    f="$(docker compose exec -T beseda python -m beseda_server.manage backup | tr -d '\r')"
    mkdir -p backups
    docker compose cp "beseda:$f" "backups/$(basename "$f")"
    chmod 600 "backups/$(basename "$f")"  # внутри хэши паролей
    docker compose exec -T beseda rm -f "$f"
    echo "Готово: backups/$(basename "$f")" ;;
  users|make-admin|reset-password|unban)
    docker compose exec -T beseda python -m beseda_server.manage "$cmd" "$@" ;;
  *) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//' ;;
esac
