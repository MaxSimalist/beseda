# Настройки сервера «Беседа». После изменения: sudo systemctl restart beseda

# Где хранятся база и файлы
BESEDA_DATA=/var/lib/beseda

# HTTP/WebSocket — только для nginx на этой же машине, наружу не открывать
BESEDA_HOST=127.0.0.1
BESEDA_PORT=8765

# UDP-порт для голоса — должен быть открыт в брандмауэре
BESEDA_UDP_HOST=0.0.0.0
BESEDA_UDP_PORT=50000
# Если голос должен идти на другой адрес, чем сайт (редко нужно)
BESEDA_UDP_PUBLIC_HOST=

# Код, без которого нельзя зарегистрироваться. Пусто — регистрация открыта всем.
BESEDA_REG_CODE=

# Максимальный размер файла (при изменении перезапустите install.sh, чтобы обновился nginx)
BESEDA_MAX_UPLOAD_MB=50
